# CampusPulse Backend Environment Configuration

# Database: PostgreSQL for production; SQLite default for local zero-setup dev
# PostgreSQL Example: postgresql+psycopg://postgres:postgres@localhost:5432/campuspulse
DATABASE_URL=sqlite:///./campuspulse_dev.db
AUTO_CREATE_TABLES=true

# Authentication
JWT_SECRET=replace_with_a_super_secret_high_entropy_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated, default is Vite dev server)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Provider: 'none' (uses deterministic rule fallback), 'gemini', or 'openai'
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=8.0

# SLA Background Monitor
SLA_MONITOR_ENABLED=true
SLA_MONITOR_INTERVAL_SECONDS=60
SLA_WARNING_THRESHOLD=0.70
SLA_AT_RISK_THRESHOLD=0.90

# Duplicate / Incident Clustering
DUPLICATE_WINDOW_HOURS=72
DUPLICATE_CONFIDENCE_THRESHOLD=0.60
INCIDENT_MIN_REPORTS=3

# Campus Local Time Offset (IST is +330 minutes)
CAMPUS_UTC_OFFSET_MINUTES=330
